{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": "./src/main/resources/static/typescript",
    "outDir": "./src/main/resources/static/javascript",
    "removeComments": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedSideEffectImports": false,
    "paths": {
      "application/*": ["./src/main/resources/static/typescript/application/*"],
      "infrastructure/*": ["./src/main/resources/static/typescript/infrastructure/*"],
      "domain/*": ["./src/main/resources/static/typescript/domain/*"]
    }
  },
  "exclude": [
    "build"
  ]
}
